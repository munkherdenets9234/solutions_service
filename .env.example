# ─────────────────────────────────────────────────────────────────────────────
# REQUIRED. The process refuses to start without these, and config.Validate
# reports every missing one in a single message rather than one per restart.
# ─────────────────────────────────────────────────────────────────────────────

APP_ENV=development
APP_PORT=8080

MONGO_URI=mongodb://eands_user:eands_pass@mongo:27017/eandstravel?authSource=admin
MONGO_DB=eandstravel

# Must be at least 32 characters. Checked at startup, not at first login.
TOKEN_SECRET=change_this_to_a_very_long_random_secret_string
TOKEN_EXPIRY_HOURS=24

# ─────────────────────────────────────────────────────────────────────────────
# OPTIONAL. Each blank value disables exactly one feature and nothing else.
# A disabled feature is logged at WARN on startup and listed by GET /readyz
# for as long as the process runs, so a degraded deployment is visible rather
# than merely quiet.
# ─────────────────────────────────────────────────────────────────────────────

# Image uploads. Blank: POST /api/v1/admin/uploads answers
# 503 FEATURE_UNAVAILABLE instead of disappearing, so a client can tell a
# missing deployment setting from a bad request.
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name
UPLOAD_MAX_BYTES=10485760

# Superadmin bootstrap — creates one platform user on startup if no account
# with this email exists yet. Needs BOTH halves; either one alone does
# nothing. Leave blank once you already have a platform user and don't want a
# fixed password sitting in .env.
SUPERADMIN_NAME=Superadmin
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=

# ─────────────────────────────────────────────────────────────────────────────
# Rate limiting (per client IP, per route group).
#
# Applied to the endpoints an anonymous caller can reach: login and password
# change, and the public lead forms (contact, quote, newsletter, reviews and
# the booking/rental/transfer intakes). Login answers differently for a known
# and an unknown email, which makes it an account-existence oracle as well as
# a guessing target; the lead forms each write a database row for free.
#
# The counters live in this process. Behind more than one replica the
# effective limit multiplies by the replica count — that is the point at which
# to move the buckets into Redis.
# ─────────────────────────────────────────────────────────────────────────────

RATE_LIMIT_ENABLED=true
AUTH_RATE_PER_MINUTE=10
LEAD_RATE_PER_MINUTE=20
RATE_LIMIT_BURST=5

# -----------------------------------------------------------------------------
# tenantcore — the platform link.
#
# Subscriptions and plans live in tenantcore, NOT here. This service holds no
# subscriptions collection: the subscription gate and the module gates both ask
# tenantcore what a tenant is entitled to, and cache the answer.
#
# Get the service key from tenantcore: POST /api/v1/admin/service-clients.
#
# If either value is blank, entitlement is UNENFORCED — every tenant is treated
# as unprovisioned, so every write passes and no module gate applies. The
# service still starts (an absent variable must not black out every storefront),
# logs an ERROR at startup, and reports it on /readyz. That is a
# misconfiguration in production, not a supported mode.
# -----------------------------------------------------------------------------

# These two also carry PASSWORD RESET mail: a tenant user who forgets their
# password is sent a code through tenantcore's mail route, so without them
# POST /password-reset/request answers 503 and /readyz reports password_reset off.
TENANTCORE_URL=http://localhost:8092
TENANTCORE_SERVICE_KEY=

# Tenantcore's Ed25519 PUBLIC key (base64), used only to verify the tokens its
# operators send to /platform/tenants/{id}/admin-users. Public half only: this
# service can verify those tokens and can never mint one. Blank switches that
# route group off (404).
TENANTCORE_PUBLIC_KEY=

# How long an entitlement is trusted before it is re-fetched.
ENTITLEMENT_TTL_SECONDS=60

# How long a cached entitlement may still be served after the TTL once
# tenantcore stops answering. This is the difference between a platform blip
# and an outage for every tenant at once — past this window the lookup fails
# honestly (500) rather than serving an hour-old answer forever. It never
# becomes a 402: telling a paying customer they had not paid because the
# platform was unreachable is the worst available answer.
ENTITLEMENT_GRACE_SECONDS=900

# Request timeout. Short on purpose: this sits on the request path, so a slow
# platform must degrade to cache quickly rather than making every write wait.
ENTITLEMENT_TIMEOUT_MS=3000

# -----------------------------------------------------------------------------
# Tenant resolution rollout switch.
#
# Where X-API-Key is turned into a tenant:
#   local       (default) this service's own tenants collection. Behaviour is
#               exactly what it was before this switch existed.
#   tenantcore  ask tenantcore, which owns tenants (cached 60 s fresh, up to
#               24 h stale while it is unreachable). Needs TENANTCORE_URL and
#               TENANTCORE_SERVICE_KEY above; startup refuses to proceed
#               without them.
# Flip it per deployment; flipping it back to local is the rollback.
TENANT_RESOLVER=local

# Limiter in front of tenant resolution. It exists ONLY when
# TENANT_RESOLVER=tenantcore (and RATE_LIMIT_ENABLED is on); in local mode the
# request path has no such limiter. It keeps a flood of bad keys from becoming
# a flood of calls to tenantcore. Per client IP: BURST requests are let through
# at once, then PER_MINUTE on average (defaults: 120 at once, then 600/min =
# 10/s). A storefront server calling from one IP must stay under that.
# The IP comes from X-Forwarded-For like every other limiter here, so behind a
# proxy or load balancer set gin's trusted-proxy handling first, or every
# visitor can pose as a different IP (or all share the proxy's).
TENANT_RESOLVE_RATE_PER_MINUTE=600
TENANT_RESOLVE_BURST=120

# ─────────────────────────────────────────────────────────────────────────────
# Reserved. Not read by the application today — the previous config struct
# carried REDIS_ADDR/REDIS_PASS fields that nothing ever used, so they were
# removed rather than left looking load-bearing. Kept here as a note: this is
# where the rate limiter's buckets belong once this service runs more than one
# replica.
# ─────────────────────────────────────────────────────────────────────────────

# REDIS_ADDR=redis:6379
# REDIS_PASS=redis_secret
